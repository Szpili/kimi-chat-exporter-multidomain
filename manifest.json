{
  "manifest_version": 3,
  "name": "Kimi Chat Exporter (kimi.com + kimi.ai)",
  "version": "1.0.1",
  "description": "Export Kimi AI conversations as Markdown and JSON",
  "permissions": [
    "storage",
    "downloads",
    "menus",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://www.kimi.com/*",
    "https://kimi.com/*",
    "https://www.kimi.ai/*",
    "https://kimi.ai/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "kimi-export-multi@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "background": {
    "page": "background.html"
  },
  "action": {
    "default_title": "Kimi Export",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.kimi.com/*",
        "https://kimi.com/*",
        "https://www.kimi.ai/*",
        "https://kimi.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; connect-src 'self' https://www.kimi.com https://kimi.com https://www.kimi.ai https://kimi.ai"
  }
}